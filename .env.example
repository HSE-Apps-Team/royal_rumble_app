# Copy this file to .env.local and fill in real values.
# See docs/ARCHITECTURE.md#configuration for details on each variable.

# --- Database (Neon Postgres) ---
# Pooled connection string, used by the app at runtime (src/db/index.ts).
DATABASE_URL=

# Direct (unpooled) connection string, used only by drizzle-kit
# (drizzle.config.ts). The pooled/pgbouncer endpoint can hang on schema
# introspection, so migrations talk to Neon directly.
DATABASE_URL_UNPOOLED=

# --- Field-level encryption ---
# 32-byte key, hex-encoded (64 hex characters), for AES-256-GCM encryption
# of sensitive fields (attendee health concerns, mentor phone numbers).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Auth.js / NextAuth ---
AUTH_SECRET=

# --- Microsoft Entra ID (Azure AD) SSO ---
# Required unless DEV_MODE=true.
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_TENANT_ID=
# Client-exposed copy of the tenant ID (used in src/app/components/loginButton.tsx).
NEXT_PUBLIC_MICROSOFT_ENTRA_TENANT_ID=

# --- Local development ---
# "true" bypasses Microsoft Entra login entirely and skips the auth
# middleware, so you can hit /admin and /mentor pages without SSO set up.
# Pages fall back to hardcoded dev IDs in this mode. Never set this in
# production. See docs/ARCHITECTURE.md#dev-mode.
DEV_MODE=false
NEXT_PUBLIC_DEV_MODE=false
